{
  "expo": {
    "name": "Block Architect",
    "slug": "block-architect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "blockarchitect",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "primaryColor": "#ff006e",
    "description": "Block Architect — drag, drop, clear & build a neon city. A premium, free-to-play block puzzle.",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.emergent.blockarchitect",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#050510"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.emergent.blockarchitect",
      "versionCode": 1,
      "permissions": [
        "VIBRATE"
      ],
      "blockedPermissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_CONTACTS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#050510"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": ""
      }
    }
  }
}
