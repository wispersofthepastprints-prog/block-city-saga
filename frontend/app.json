{
  "expo": {
    "name": "Tetris Architect",
    "slug": "tetris-architect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tetrisarchitect",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "primaryColor": "#ff006e",
    "description": "Tetris Architect — drag, drop, clear & build a neon city. A premium, free-to-play block puzzle.",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wispersofthepast.tetrisarchitect",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#050510"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.wispersofthepast.tetrisarchitect",
      "versionCode": 1,
      "permissions": [
        "VIBRATE",
        "com.google.android.gms.permission.AD_ID"
      ],
      "blockedPermissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_CONTACTS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#050510"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1508365322358813~3278044849",
          "iosAppId": "ca-app-pub-1508365322358813~0000000000",
          "userTrackingUsageDescription": "This identifier is used to deliver personalized ads."
        }
      ]
    ],
    "react-native-google-mobile-ads": {
      "android_app_id": "ca-app-pub-1508365322358813~3278044849",
      "ios_app_id": "ca-app-pub-1508365322358813~0000000000",
      "user_tracking_usage_description": "This identifier is used to deliver personalized ads."
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": ""
      }
    }
  }
}
